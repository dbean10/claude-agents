#!/usr/bin/env python3
"""Keep the shared writing section identical across every agent.

One source, `shared/writing.md`. This inserts it into each `global/*.md`
between markers, immediately before that agent's `## Output format`
heading, and `--check` asserts every copy still matches — so the
propagation this repo has already done twice by hand (the first-principles
template, the mechanics-belong-in-code principle) stops relying on nobody
forgetting.

  bin/sync-shared           rewrite every agent from the source
  bin/sync-shared --check   assert every copy matches; exit 1 if not

It also asserts the source names no caller-specific vocabulary. These
agents install into many projects; a term belonging to one project's
workflow, appearing in shared text, couples every installation to that one
workflow. Terms are multi-word by design — `design`, `build` and `verify`
are ordinary verbs, and forbidding them bare would false-positive on every
honest sentence until someone switched the check off.
"""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "shared" / "writing.md"
AGENTS = sorted((ROOT / "global").glob("*.md"))
ANCHOR = "## Output format"
START = "<!-- shared:writing start — generated by bin/sync-shared, do not edit here -->"
END = "<!-- shared:writing end -->"

COUPLED_TERMS = [
    "stage record", "stage contract", "work item", "acceptance criteri",
    "acceptance test", "findings register", "code-factory", "factory-doctor",
    "factory.toml", "scope.md", "design.md", "the manifest", "the tenant",
    "the pipeline", "burndown", "ratchet", "traversal", "/approve",
    "/factory:",
]


def coupling_failures(text: str) -> list[str]:
    out = []
    for lineno, line in enumerate(text.splitlines(), 1):
        low = line.lower()
        for term in COUPLED_TERMS:
            if term in low:
                out.append(f"shared/writing.md:{lineno}: caller-specific "
                           f"term {term!r} — {line.strip()[:60]}")
    return out


def block(body: str) -> str:
    return f"{START}\n\n{body.strip()}\n\n{END}\n"


def rewrite(text: str, new_block: str, name: str) -> str:
    """Replace an existing block, or insert one before the anchor."""
    if START in text:
        if text.count(START) != 1 or text.count(END) != 1:
            sys.exit(f"ABORT: {name} has {text.count(START)} start and "
                     f"{text.count(END)} end markers, expected one each")
        head, rest = text.split(START, 1)
        _, tail = rest.split(END, 1)
        return head + new_block.rstrip("\n") + tail
    n = text.count("\n" + ANCHOR)
    if n != 1:
        sys.exit(f"ABORT: {name} has {n} '{ANCHOR}' headings, expected "
                 "exactly 1 — insert the markers by hand and re-run")
    return text.replace("\n" + ANCHOR, "\n" + new_block + "\n" + ANCHOR)


def main() -> int:
    check = "--check" in sys.argv[1:]
    if not SOURCE.is_file():
        print(f"ABORT: {SOURCE} is missing — nothing to sync, which is not "
              "a pass", file=sys.stderr)
        return 1
    if not AGENTS:
        print("ABORT: no agent files found, which is not a pass",
              file=sys.stderr)
        return 1

    body = SOURCE.read_text()
    problems = coupling_failures(body)
    new_block = block(body)

    drifted = []
    for path in AGENTS:
        text = path.read_text()
        want = rewrite(text, new_block, path.name)
        if text == want:
            continue
        if check:
            drifted.append(path.name)
        else:
            path.write_text(want)

    if problems:
        print("coupling failures:", file=sys.stderr)
        for p in problems:
            print(f"  x {p}", file=sys.stderr)
    if drifted:
        print("out of sync with shared/writing.md:", file=sys.stderr)
        for d in drifted:
            print(f"  x {d} — run bin/sync-shared", file=sys.stderr)
    if problems or drifted:
        return 1

    verb = "verified" if check else "synced"
    print(f"shared: {verb} {len(AGENTS)} agent(s) against shared/writing.md "
          f"({len(COUPLED_TERMS)} coupled terms checked)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
